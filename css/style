
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root{
  --bg:#070707;
  --bg-soft:#0b0b0b;
  --panel:rgba(255,255,255,.035);
  --panel-hover:rgba(255,255,255,.06);
  --line:rgba(255,255,255,.08);
  --text:#f5f5f5;
  --muted:#8f8f8f;
  --red:#ff2a2a;
  --red-soft:rgba(255,42,42,.12);
  --ease:cubic-bezier(.22,1,.36,1);
}

*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  min-height:100vh;
  background:
    radial-gradient(circle at 50% -15%,rgba(255,255,255,.07),transparent 35%),
    radial-gradient(circle at 10% 35%,rgba(255,42,42,.055),transparent 28%),
    var(--bg);
  color:var(--text);
  font-family:Inter,system-ui,sans-serif;
  overflow-x:hidden;
}
body::before{
  content:"";
  position:fixed;inset:0;pointer-events:none;z-index:-1;
  background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);
  background-size:55px 55px;
  mask-image:linear-gradient(to bottom,black,transparent 80%);
}
a{color:inherit;text-decoration:none}
.container{width:min(1100px,calc(100% - 40px));margin:auto}

header{
  position:fixed;top:0;left:0;width:100%;z-index:50;
  padding:22px 0;
  background:linear-gradient(to bottom,rgba(7,7,7,.9),rgba(7,7,7,.35),transparent);
  backdrop-filter:blur(12px);
}
.navbar{display:flex;align-items:center;justify-content:space-between;gap:25px}
.brand{display:flex;align-items:center;gap:11px;font-weight:700;letter-spacing:-.03em}
.brand-dot{width:9px;height:9px;border-radius:50%;background:var(--red);box-shadow:0 0 18px var(--red)}
.nav-wrap{position:relative}
nav ul{display:flex;gap:3px;list-style:none;padding:5px;border:1px solid var(--line);background:rgba(15,15,15,.72);border-radius:999px;position:relative;isolation:isolate}
nav a{display:block;padding:9px 14px;color:#9b9b9b;font-size:12px;font-weight:500;position:relative;z-index:2;transition:color .25s ease}
nav a:hover,nav a.active{color:#fff}
.nav-indicator{
  position:absolute;left:0;top:0;height:100%;width:0;z-index:1;
  background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.07);
  border-radius:999px;pointer-events:none;
  transition:left .45s var(--ease),width .45s var(--ease),opacity .25s ease;
}
.header-contact{
  font-size:12px;color:#aaa;padding:10px 15px;border:1px solid var(--line);
  border-radius:999px;transition:.3s var(--ease)
}
.header-contact:hover{color:#fff;border-color:rgba(255,255,255,.2);transform:translateY(-2px)}

main{padding-top:135px;padding-bottom:90px}
.hero{min-height:72vh;display:flex;align-items:center;position:relative}
.hero::after{
  content:"";position:absolute;width:380px;height:380px;right:2%;top:8%;
  background:radial-gradient(circle,rgba(255,42,42,.09),transparent 68%);
  filter:blur(20px);pointer-events:none
}
.eyebrow{font-size:11px;text-transform:uppercase;letter-spacing:.22em;color:#777;margin-bottom:22px}
.eyebrow span{color:var(--red)}
h1{font-size:clamp(48px,8vw,92px);line-height:.93;letter-spacing:-.07em;max-width:850px}
.hero h1 span{color:var(--red);text-shadow:0 0 45px rgba(255,42,42,.18)}
.hero-copy{max-width:620px;margin-top:28px;color:#8d8d8d;font-size:14px;line-height:1.8}
.hero-actions{display:flex;gap:10px;margin-top:32px}
.btn{padding:12px 18px;border-radius:999px;border:1px solid var(--line);font-size:12px;font-weight:600;transition:.35s var(--ease)}
.btn-primary{background:#fff;color:#080808;border-color:#fff}
.btn:hover{transform:translateY(-3px)}
.btn-primary:hover{box-shadow:0 12px 35px rgba(255,255,255,.1)}
.btn-ghost:hover{background:var(--panel-hover);border-color:rgba(255,255,255,.2)}

.section{padding:100px 0}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:38px}
.section-label{font-size:11px;color:var(--red);letter-spacing:.2em;text-transform:uppercase;margin-bottom:12px}
h2{font-size:clamp(32px,5vw,56px);letter-spacing:-.055em}
.section-sub{max-width:420px;color:#777;font-size:13px;line-height:1.7}

.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.card{
  border:1px solid var(--line);background:var(--panel);border-radius:18px;padding:25px;
  transition:transform .5s var(--ease),background .35s ease,border-color .35s ease;
  position:relative;overflow:hidden
}
.card::before{
  content:"";position:absolute;width:180px;height:180px;left:var(--mx,50%);top:var(--my,50%);
  transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(255,255,255,.07),transparent 65%);
  opacity:0;transition:opacity .35s ease;pointer-events:none
}
.card:hover{transform:translateY(-7px);background:var(--panel-hover);border-color:rgba(255,255,255,.14)}
.card:hover::before{opacity:1}
.project-icon{width:42px;height:42px;border-radius:12px;object-fit:cover;margin-bottom:38px}
.card h3{font-size:15px;letter-spacing:-.02em;margin-bottom:10px}
.card p{font-size:12px;color:#777;line-height:1.75}
.card .tag{display:inline-block;margin-top:22px;color:#777;font-size:10px;text-transform:uppercase;letter-spacing:.12em}

.timeline{display:flex;flex-direction:column;position:relative}
.timeline::before{content:"";position:absolute;left:8px;top:10px;bottom:10px;width:1px;background:var(--line)}
.timeline-item{display:grid;grid-template-columns:35px 150px 1fr;gap:25px;padding:0 0 65px;position:relative}
.timeline-dot{width:17px;height:17px;border-radius:50%;background:var(--bg);border:1px solid #444;position:relative;z-index:2;margin-top:3px}
.timeline-item:first-child .timeline-dot{background:var(--red);border-color:var(--red);box-shadow:0 0 22px rgba(255,42,42,.35)}
.timeline-date{font-size:10px;text-transform:uppercase;letter-spacing:.14em;color:#555;padding-top:3px}
.timeline-content{display:grid;grid-template-columns:52px 1fr;gap:18px}
.timeline-logo{width:52px;height:52px;border-radius:14px;object-fit:cover;border:1px solid var(--line)}
.timeline-content h3{font-size:16px;margin-bottom:6px}
.timeline-role{font-size:11px;color:var(--red);margin-bottom:12px}
.timeline-content p{font-size:12px;color:#777;line-height:1.75;max-width:650px}

.contact-box{
  border:1px solid var(--line);border-radius:22px;padding:45px;
  background:linear-gradient(135deg,rgba(255,255,255,.05),rgba(255,255,255,.015));
  display:flex;justify-content:space-between;align-items:center;gap:30px
}
.contact-box p{color:#777;font-size:13px;line-height:1.7;max-width:520px}
.socials{display:flex;gap:8px;flex-wrap:wrap}
.social{padding:11px 15px;border:1px solid var(--line);border-radius:999px;font-size:11px;color:#999;transition:.3s}
.social:hover{color:#fff;background:var(--panel-hover);transform:translateY(-2px)}

.page-intro{padding:60px 0 75px}
.page-intro h1{font-size:clamp(45px,7vw,76px)}
.page-intro p{margin-top:22px;color:#777;max-width:580px;font-size:13px;line-height:1.8}
footer{padding:30px 0 45px;border-top:1px solid var(--line);color:#555;font-size:10px}
.footer-inner{display:flex;justify-content:space-between;gap:20px}

.reveal{opacity:0;transform:translateY(25px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.reveal.visible{opacity:1;transform:none}
.delay-1{transition-delay:.08s}.delay-2{transition-delay:.16s}.delay-3{transition-delay:.24s}

@media(max-width:850px){
  .header-contact{display:none}
  nav a{padding:8px 9px}
  .grid{grid-template-columns:1fr}
  .timeline-item{grid-template-columns:25px 1fr}
  .timeline-date{grid-column:2;grid-row:1}
  .timeline-content{grid-column:2}
  .contact-box{flex-direction:column;align-items:flex-start}
}
@media(max-width:620px){
  .container{width:min(100% - 24px,1100px)}
  header{padding:15px 0}
  .brand{display:none}
  .navbar{justify-content:center}
  nav ul{max-width:100%;overflow-x:auto}
  nav a{white-space:nowrap;font-size:10px;padding:8px}
  main{padding-top:105px}
  .hero{min-height:75vh}
  .hero-actions{flex-wrap:wrap}
  .section{padding:70px 0}
  .section-head{display:block}
  .section-sub{margin-top:15px}
  .contact-box{padding:28px}
  .footer-inner{flex-direction:column}
}
